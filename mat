local function createToggle(parent, name, default, callback)
    local Toggle = Instance.new("Frame")
    Toggle.Name = name .. "Toggle"
    Toggle.Size = UDim2.new(1, 0, 0, 20)
    Toggle.BackgroundTransparency = 1
    Toggle.Parent = parent
    
    local Circle = Instance.new("Frame")
    Circle.Name = "Circle"
    Circle.Size = UDim2.new(0, 14, 0, 14)
    Circle.Position = UDim2.new(0, 0, 0.5, -7)
    Circle.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
    Circle.BorderSizePixel = 0
    Circle:SetAttribute("OriginalTransparency", 0)
    Circle.Parent = Toggle
    
    local CircleCorner = Instance.new("UICorner")
    CircleCorner.CornerRadius = UDim.new(1, 0)
    CircleCorner.Parent = Circle
    
    local CircleBorder = Instance.new("UIStroke")
    CircleBorder.Color = Color3.fromRGB(37, 37, 37)
    CircleBorder.Thickness = 1
    CircleBorder.Parent = Circle
    
    local Label = Instance.new("TextLabel")
    Label.Name = "Label"
    Label.Size = UDim2.new(1, -25, 1, 0)
    Label.Position = UDim2.new(0, 25, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = name
    Label.TextColor3 = Color3.fromRGB(112, 112, 112)
    Label.Font = Enum.Font.Gotham
    Label.TextSize = 11
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Toggle
    
    local enabled = default
    
    local function updateToggleVisuals()
        local sectionName = parent.Name:gsub("Section", "")
        local settingName = name:gsub(" ", "")
        
        -- Special cases for mapping
        if sectionName == "Aimbot" and settingName:find("Target:") then
            settingName = "TargetMode"
            enabled = (Settings[sectionName][settingName] == name:split(": ")[2])
        elseif Settings[sectionName] and Settings[sectionName][settingName] ~= nil then
            enabled = Settings[sectionName][settingName]
        end
        if enabled then
            Circle.BackgroundColor3 = Color3.fromRGB(255, 156, 207)
            CircleBorder.Color = Color3.fromRGB(255, 156, 207)
            Label.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            Circle.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
            CircleBorder.Color = Color3.fromRGB(37, 37, 37)
            Label.TextColor3 = Color3.fromRGB(112, 112, 112)
        end
    end
    
    table.insert(UIUpdateFunctions, updateToggleVisuals)
    
    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(1, 0, 1, 0)
    Button.BackgroundTransparency = 1
    Button.Text = ""
    Button.Parent = Toggle
    
    Button.MouseButton1Click:Connect(function()
        enabled = not enabled
        callback(enabled) -- Update setting FIRST
        updateToggleVisuals() -- Update UI based on new setting
    end)
    
    updateToggleVisuals() -- Init state
    return Toggle
end

local function createSlider(parent, name, min, max, default, callback)
    local Slider = Instance.new("Frame")
    Slider.Name = name .. "Slider"
    Slider.Size = UDim2.new(1, 0, 0, 35)
    Slider.BackgroundTransparency = 1
    Slider.Parent = parent
    
    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0.5, 0, 0, 12)
    Label.BackgroundTransparency = 1
    Label.Text = name
    Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    Label.Font = Enum.Font.Gotham
    Label.TextSize = 10
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Slider
    
    local Value = Instance.new("TextLabel")
    Value.Size = UDim2.new(0.5, 0, 0, 12)
    Value.Position = UDim2.new(0.5, 0, 0, 0)
    Value.BackgroundTransparency = 1
    Value.Text = tostring(default) .. "/" .. tostring(max)
    Value.TextColor3 = Color3.fromRGB(255, 255, 255)
    Value.Font = Enum.Font.Gotham
    Value.TextSize = 10
    Value.TextXAlignment = Enum.TextXAlignment.Right
    Value.Parent = Slider
    
    local Track = Instance.new("Frame")
    Track.Size = UDim2.new(1, 0, 0, 11)
    Track.Position = UDim2.new(0, 0, 0, 18)
    Track.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
    Track.BorderSizePixel = 0
    Track:SetAttribute("OriginalTransparency", 0)
    Track.Parent = Slider
    
    local TrackCorner = Instance.new("UICorner")
    TrackCorner.CornerRadius = UDim.new(0, 10)
    TrackCorner.Parent = Track
    
    local TrackBorder = Instance.new("UIStroke")
    TrackBorder.Color = Color3.fromRGB(34, 34, 34)
    TrackBorder.Thickness = 1
    TrackBorder.Parent = Track
    
    local Fill = Instance.new("Frame")
    Fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    Fill.BackgroundColor3 = Color3.fromRGB(255, 156, 207)
    Fill.BorderSizePixel = 0
    Fill:SetAttribute("OriginalTransparency", 0)
    Fill.Parent = Track
    
    local FillCorner = Instance.new("UICorner")
    FillCorner.CornerRadius = UDim.new(0, 10)
    FillCorner.Parent = Fill
    
    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.new(0, 9, 0, 9)
    Knob.Position = UDim2.new(1, -5, 0.5, -4.5)
    Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Knob.BorderSizePixel = 0
    Knob:SetAttribute("OriginalTransparency", 0)
    Knob.Parent = Fill
    
    local KnobCorner = Instance.new("UICorner")
    KnobCorner.CornerRadius = UDim.new(1, 0)
    KnobCorner.Parent = Knob
    
    local dragging = false
    
    Track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
        end
    end)
    
    Track.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    local function updateSliderVisuals()
        local sectionName = parent.Name:gsub("Section", "")
        if Settings[sectionName] then
            local currentVal = Settings[sectionName][name:gsub(" ", "")]
            if currentVal ~= nil then
                if typeof(currentVal) == "number" then
                    -- Handle Smoothness scale (0.15 vs 15)
                    if name == "Smoothness" then
                        currentVal = 101 - (currentVal * 100)
                    end
                    
                    local percentage = math.clamp((currentVal - min) / (max - min), 0, 1)
                    Fill.Size = UDim2.new(percentage, 0, 1, 0)
                    Value.Text = tostring(math.floor(currentVal)) .. "/" .. tostring(max)
                end
            end
        end
    end
    
    table.insert(UIUpdateFunctions, updateSliderVisuals)
    
    AddConnection(UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local mouse = UserInputService:GetMouseLocation()
            local relativeX = math.clamp(mouse.X - Track.AbsolutePosition.X, 0, Track.AbsoluteSize.X)
            local percentage = relativeX / Track.AbsoluteSize.X
            local value = math.floor(min + (max - min) * percentage)
            
            Fill.Size = UDim2.new(percentage, 0, 1, 0)
            Value.Text = tostring(value) .. "/" .. tostring(max)
            callback(value)
        end
    end))
    
    updateSliderVisuals() -- INIT
    return Slider
end

