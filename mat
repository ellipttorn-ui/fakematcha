----------------------------------------------------------
local ConfigPath = "Matcha/Configs/"
if makefolder then pcall(function() makefolder("Matcha") makefolder("Matcha/Configs") end) end

local function serialize(val)
    if typeof(val) == "Color3" then
        return {R = val.R, G = val.G, B = val.B, Type = "Color3"}
    elseif typeof(val) == "EnumItem" then
        return {Name = tostring(val), Type = "Enum"}
    end
    return val
end

local function deserialize(val)
    if typeof(val) == "table" and val.Type == "Color3" then
        return Color3.new(val.R, val.G, val.B)
    elseif typeof(val) == "table" and val.Type == "Enum" then
        local s = string.split(val.Name, ".")
        return Enum[s[2]][s[3]]
    end
    return val
end

local function saveConfig(name)
    local data = {}
    for i, v in pairs(Settings) do
        data[i] = {}
        for x, y in pairs(v) do
            data[i][x] = serialize(y)
        end
    end
    if writefile then
        writefile(ConfigPath .. name .. ".json", HttpService:JSONEncode(data))
    end
end

----------------------------------------------------------
-- UI SYNC SYSTEM
----------------------------------------------------------
local UIUpdateFunctions = {}

local function refreshUI()
    for _, fn in pairs(UIUpdateFunctions) do
        pcall(fn)
    end
end

local function loadConfig(name)
    if isfile and isfile(ConfigPath .. name .. ".json") then
        local raw = readfile(ConfigPath .. name .. ".json")
        local data = HttpService:JSONDecode(raw)
        for i, v in pairs(data) do
            if Settings[i] then
                for x, y in pairs(v) do
                    Settings[i][x] = deserialize(y)
                end
            end
        end
        refreshUI()
        print("Loaded config: " .. name)
        
        -- Flash the UI to show success
        if MainWindow then
            local stroke = MainWindow:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke", MainWindow)
            local oldColor = stroke.Color
            TweenService:Create(stroke, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, 0, true), {Color = Color3.fromRGB(255, 156, 207)}):Play()
        end
        return true
    end
    return false
end

local function deleteConfig(name)
    if isfile and isfile(ConfigPath .. name .. ".json") then
        delfile(ConfigPath .. name .. ".json")
    end
end

local function listConfigs()
    local files = {}
    if listfiles then
        for _, file in pairs(listfiles(ConfigPath)) do
            if file:sub(-5) == ".json" then
                local name = file:match("([^/]+)%.json$")
                table.insert(files, name)
            end
        end
    end
    return files
end


