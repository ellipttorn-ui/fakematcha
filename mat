-- SPEED GHOSTS (ROBLOX) BUT CONFIGURED BY CASPATCH
----------------------------------------------------------
local angle = 30 -- sway amount
local cyclesPerMinute = 40.5 * 50  
local cycleTime = 60 / cyclesPerMinute
local halfCycle = cycleTime / 2

local animRunning = false
local originalC0 = nil
local waist = nil

local function startWaistJitter()
    if animRunning or not waist then return end
    animRunning = true

    task.spawn(function()
        local leftC0 = originalC0 * CFrame.Angles(0, math.rad(-angle), 0)
        local centerC0 = originalC0
        local tweenInfo = TweenInfo.new(halfCycle, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)

        while animRunning do
            if not waist or not waist.Parent then break end
            TweenService:Create(waist, tweenInfo, {C0 = leftC0}):Play()
            task.wait(halfCycle)
            if not animRunning then break end
            TweenService:Create(waist, tweenInfo, {C0 = centerC0}):Play()
            task.wait(halfCycle)
        end
    end)
end

local function stopWaistJitter()
    animRunning = false
    if waist then
        TweenService:Create(waist, TweenInfo.new(0.15), {C0 = originalC0}):Play()
    end
end

