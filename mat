-- UI Fade Helper
local FadeDebounce = false
local function SetUITransparency(transparency, duration)
    local tweenInfo = TweenInfo.new(duration or 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    
    -- If we are fading in, make sure it's visible first
    if transparency < 1 then
        MainWindow.Visible = true
    end
    
    -- Main Components
    TweenService:Create(MainWindow, tweenInfo, {BackgroundTransparency = transparency == 1 and 1 or 0}):Play()
    if MainStroke then TweenService:Create(MainStroke, tweenInfo, {Transparency = transparency}):Play() end
    if TopBar then TweenService:Create(TopBar, tweenInfo, {BackgroundTransparency = transparency == 1 and 1 or 0}):Play() end
    if TopBarLine then TweenService:Create(TopBarLine, tweenInfo, {BackgroundTransparency = transparency == 1 and 1 or 0.5}):Play() end
    
    -- Descendants
    for _, obj in pairs(MainWindow:GetDescendants()) do
        local originalTrans = obj:GetAttribute("OriginalTransparency")
        
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            -- Text should stay fully visible when fading in
            TweenService:Create(obj, tweenInfo, {TextTransparency = transparency}):Play()
            -- Background behavior (TabButtons are transparent, hence originalTrans=1)
            local targetBG = originalTrans or 1
            TweenService:Create(obj, tweenInfo, {BackgroundTransparency = (transparency == 1) and 1 or targetBG}):Play()
            
            if obj:FindFirstChildOfClass("UIStroke") then
                TweenService:Create(obj:FindFirstChildOfClass("UIStroke"), tweenInfo, {Transparency = transparency}):Play()
            end
        elseif obj:IsA("Frame") then
            local target = originalTrans or 0
            if obj.BackgroundTransparency >= 1 and not originalTrans then target = 1 end
            
            TweenService:Create(obj, tweenInfo, {BackgroundTransparency = transparency == 1 and 1 or target}):Play()
        elseif obj:IsA("UIStroke") then
            TweenService:Create(obj, tweenInfo, {Transparency = (transparency == 1) and 1 or (originalTrans or 0)}):Play()
        elseif obj:IsA("ImageLabel") then
            TweenService:Create(obj, tweenInfo, {ImageTransparency = transparency}):Play()
        end
    end
    
    -- Handle visibility at the end of fade out
    if transparency == 1 then
        task.delay(duration or 0.3, function()
            if not FadeDebounce then -- Only hide if we aren't currently fading in
                MainWindow.Visible = false
            end
        end)
    end
end

-- Toggle UI with Fade
AddConnection(UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == Enum.KeyCode.Insert then
        if MainWindow.Visible and not FadeDebounce then
            FadeDebounce = false
            SetUITransparency(1, 0.4)
        elseif not MainWindow.Visible then
            FadeDebounce = true
            SetUITransparency(0, 0.4)
            task.delay(0.4, function() FadeDebounce = false end)
        end
    end
end))

