-- LOADING ANIMATION & SOUND
local function StartLoading()
    local Splash = Instance.new("Frame")
    Splash.Size = UDim2.new(0, 360, 0, 160)
    Splash.Position = UDim2.new(0.5, -180, 0.5, -80)
    Splash.BackgroundColor3 = Color3.fromRGB(12, 12, 12)
    Splash.BackgroundTransparency = 1 -- Start transparent for fade-in
    Splash.ZIndex = 1100
    Splash.ClipsDescendants = true
    Splash.Parent = ScreenGui
    
    local SplashCorner = Instance.new("UICorner", Splash)
    SplashCorner.CornerRadius = UDim.new(0, 10)
    
    local SplashStroke = Instance.new("UIStroke", Splash)
    SplashStroke.Color = Color3.fromRGB(255, 156, 207)
    SplashStroke.Thickness = 1.5
    SplashStroke.Transparency = 1 -- Start transparent
    
    -- Mini Snow for Splash
    local SplashSnowContainer = Instance.new("Frame", Splash)
    SplashSnowContainer.Size = UDim2.new(1,0,1,0)
    SplashSnowContainer.BackgroundTransparency = 1

    local Ring = Instance.new("Frame")
    Ring.Size = UDim2.new(0, 50, 0, 50)
    Ring.Position = UDim2.new(0, 30, 0.5, -25)
    Ring.BackgroundColor3 = Color3.fromRGB(255, 156, 207)
    Ring.BackgroundTransparency = 1 -- Start transparent
    Ring.Parent = Splash
    
    Instance.new("UICorner", Ring).CornerRadius = UDim.new(1, 0)
    local RingStroke = Instance.new("UIStroke", Ring)
    RingStroke.Thickness = 3
    RingStroke.Color = Color3.fromRGB(255, 156, 207)
    RingStroke.Transparency = 1 -- Start transparent
    
    local RingGradient = Instance.new("UIGradient", Ring)
    RingGradient.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(0.5, 0.5),
        NumberSequenceKeypoint.new(1, 1)
    })
    
    local LoadingText = Instance.new("TextLabel")
    LoadingText.Size = UDim2.new(1, -130, 1, 0)
    LoadingText.Position = UDim2.new(0, 110, 0, 0) -- Increased spacing (was 90)
    LoadingText.BackgroundTransparency = 1
    LoadingText.Text = "LOADING MATCHA"
    LoadingText.TextColor3 = Color3.fromRGB(255, 156, 207)
    LoadingText.TextTransparency = 1 -- Start transparent
    LoadingText.Font = Enum.Font.GothamBold
    LoadingText.TextSize = 16
    LoadingText.TextXAlignment = Enum.TextXAlignment.Left
    LoadingText.Parent = Splash
    
    MainWindow.Visible = false
    
    -- Sound
    local s = Instance.new("Sound", game.Workspace)
    s.SoundId = "rbxassetid://4835664213"
    s.Volume = 1
    s:Play()
    game:GetService("Debris"):AddItem(s, 5)
    
    -- Fade In Tweens (1.5s)
    TweenService:Create(Splash, TweenInfo.new(1.5), {BackgroundTransparency = 0}):Play()
    TweenService:Create(SplashStroke, TweenInfo.new(1.5), {Transparency = 0.5}):Play()
    TweenService:Create(Ring, TweenInfo.new(1.5), {BackgroundTransparency = 0.8}):Play()
    TweenService:Create(RingStroke, TweenInfo.new(1.5), {Transparency = 0}):Play()
    TweenService:Create(LoadingText, TweenInfo.new(1.5), {TextTransparency = 0}):Play()

    -- Animation Loop (Rotation, Snow & Dots)
    local loadingActive = true
    task.spawn(function()
        local rot = 0
        while loadingActive and Splash.Parent do
            rot = rot + 6
            Ring.Rotation = rot
            task.wait()
        end
    end)

    task.spawn(function()
        local dots = 0
        while loadingActive and Splash.Parent do
            dots = (dots + 1) % 4
            local dotStr = string.rep(".", dots)
            LoadingText.Text = "LOADING MATCHA" .. dotStr
            task.wait(0.5)
        end
    end)

    task.spawn(function()
        while loadingActive and Splash.Parent do
            local size = math.random(2, 4)
            local sn = Instance.new("Frame", SplashSnowContainer)
            sn.Size = UDim2.new(0, size, 0, size)
            sn.Position = UDim2.new(math.random(), 0, 0, -5)
            sn.BackgroundColor3 = Color3.new(1,1,1)
            sn.BorderSizePixel = 0
            Instance.new("UICorner", sn).CornerRadius = UDim.new(1,0)
            
            TweenService:Create(sn, TweenInfo.new(math.random(1.5, 2.5), Enum.EasingStyle.Linear), {
                Position = UDim2.new(sn.Position.X.Scale + math.random(-5,5)/100, 0, 1, 5)
            }):Play()
            game:GetService("Debris"):AddItem(sn, 3)
            task.wait(0.12)
        end
    end)

    task.wait(4) -- Total wait time (accounts for fade-in + display)
    loadingActive = false
    
    TweenService:Create(Splash, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
    TweenService:Create(Ring, TweenInfo.new(0.5), {BackgroundTransparency = 1, Rotation = 720}):Play()
    TweenService:Create(LoadingText, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
    TweenService:Create(SplashStroke, TweenInfo.new(0.5), {Transparency = 1}):Play()
    task.wait(0.5)
    Splash:Destroy()
    
    -- Fade in Main UI
    MainWindow.Visible = true -- FORCE VISIBLE
    FadeDebounce = true -- Prevent fade-out logic from hiding it
    SetUITransparency(1, 0) -- Pre-set all to transparent
    SetUITransparency(0, 0.6)
    task.delay(0.6, function() FadeDebounce = false end)
end

task.spawn(StartLoading)

