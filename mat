local function removeESP(player)
    if ESPObjects[player] then
        ESPObjects[player].Box:Remove()
        ESPObjects[player].Name:Remove()
        ESPObjects[player].BoxOutline:Remove()
        ESPObjects[player] = nil
    end
end

local function updateESP()
    for player, esp in pairs(ESPObjects) do
        pcall(function()
            if player and player.Parent and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") then
                local humanoid = player.Character.Humanoid
                local hrp = player.Character.HumanoidRootPart
                
                if humanoid.Health > 0 then
                    local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    
                    if onScreen and vector.Z > 0 and Settings.ESP.Enabled then
                        local headPos = Camera:WorldToViewportPoint((hrp.CFrame * CFrame.new(0, 2, 0)).Position)
                        local legPos = Camera:WorldToViewportPoint((hrp.CFrame * CFrame.new(0, -3, 0)).Position)
                        
                        local height = math.abs(headPos.Y - legPos.Y)
                        local width = height / 2.5
                        
                        if height > 0 and width > 0 then
                            esp.Box.Size = Vector2.new(width, height)
                            esp.Box.Position = Vector2.new(vector.X - width / 2, vector.Y - height / 2)
                            esp.Box.Visible = Settings.ESP.Boxes
                            esp.Box.Color = Settings.ESP.BoxColor
                            esp.Box.Thickness = Settings.ESP.BoxThickness
                            
                            esp.BoxOutline.Size = Vector2.new(width, height)
                            esp.BoxOutline.Position = Vector2.new(vector.X - width / 2, vector.Y - height / 2)
                            esp.BoxOutline.Visible = Settings.ESP.Boxes
                            
                            esp.Name.Text = player.DisplayName
                            esp.Name.Position = Vector2.new(vector.X, vector.Y - height / 2 - 16)
                            esp.Name.Visible = Settings.ESP.Names
                            esp.Name.Color = Settings.ESP.BoxColor
                        else
                            esp.Box.Visible = false
                            esp.BoxOutline.Visible = false
                            esp.Name.Visible = false
                        end
                    else
                        esp.Box.Visible = false
                        esp.BoxOutline.Visible = false
                        esp.Name.Visible = false
                    end
                else
                    esp.Box.Visible = false
                    esp.BoxOutline.Visible = false
                    esp.Name.Visible = false
                end
            else
                esp.Box.Visible = false
                esp.BoxOutline.Visible = false
                esp.Name.Visible = false
            end
        end)
    end
end

local function getClosestPlayer()
    -- OM STICKY AIM ÄR PÅ OCH VI HAR EN LOCKED TARGET - FORTSÄTT SIKTA PÅ DEN!
    if Settings.Aimbot.StickyAim and stickyLocked and stickyTarget then
        if stickyTarget.Character and stickyTarget.Character:FindFirstChild("Head") then
            local humanoid = stickyTarget.Character:FindFirstChildOfClass("Humanoid")
            local isDowned = humanoid and (humanoid.Health <= 5 or stickyTarget.Character:FindFirstChild("BodyEffects") and stickyTarget.Character.BodyEffects:FindFirstChild("K.O") and stickyTarget.Character.BodyEffects["K.O"].Value)
            
            if humanoid and humanoid.Health > 0 and (not Settings.Aimbot.IgnoreDowned or not isDowned) then
                return stickyTarget -- RETURNERA SAMMA PERSON
            else
                -- Target dog eller dog - släpp låset
                stickyLocked = false
                stickyTarget = nil
                print("🔓 Target downed/died - lock released")
            end
        else
            -- Target har ingen character - släpp låset
            stickyLocked = false
            stickyTarget = nil
            print("🔓 Target lost - lock released")
        end
    end
    
    -- Hitta ny target
    local closestPlayer = nil
    local shortestDistance = math.huge
    
    if Settings.Aimbot.TargetMode == "Mouse" then
        shortestDistance = Settings.Aimbot.FOVSize
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            local head = player.Character:FindFirstChild("Head")
            
            if humanoid and humanoid.Health > 0 and head then
                -- Downed check
                local isDowned = (humanoid.Health <= 5 or player.Character:FindFirstChild("BodyEffects") and player.Character.BodyEffects:FindFirstChild("K.O") and player.Character.BodyEffects["K.O"].Value)
                if Settings.Aimbot.IgnoreDowned and isDowned then
                    continue
                end

                if Settings.Aimbot.TeamCheck and player.Team == LocalPlayer.Team then
                    continue
                end
                
                local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                
                if onScreen then
                    if Settings.Aimbot.TargetMode == "Mouse" then
                        local mousePos = UserInputService:GetMouseLocation()
                        local mouseDistance = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        
                        if mouseDistance < shortestDistance then
                            closestPlayer = player
                            shortestDistance = mouseDistance
                        end
                    else -- Distance mode
                        local charDistance = (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and (player.Character.HumanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude) or math.huge
                        
                        if charDistance < shortestDistance then
                            closestPlayer = player
                            shortestDistance = charDistance
                        end
                    end
                end
            end
        end
    end
    
    -- Om sticky aim är PÅ och vi hittade någon - LÅS!
    if Settings.Aimbot.StickyAim and closestPlayer and Settings.Aimbot.Enabled then
        stickyTarget = closestPlayer
        stickyLocked = true
        print("🔒 LOCKED: " .. closestPlayer.DisplayName)
    end
    
    return closestPlayer
end

-- Main Loop
AddConnection(RunService.RenderStepped:Connect(function()
    local mousePos = UserInputService:GetMouseLocation()
    FOVCircle.Position = mousePos
    FOVCircle.Radius = Settings.Aimbot.FOVSize
    FOVCircle.Visible = Settings.Aimbot.ShowFOV -- Den ska alltid finnas om ShowFOV är på
    
    -- Aimbot
    if Settings.Aimbot.Enabled then
        if Settings.Aimbot.Always or aimTriggered then
            local target = getClosestPlayer()
            
            if target and target.Character and target.Character:FindFirstChild("Head") then
                local head = target.Character.Head
                Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, head.Position), Settings.Aimbot.Smoothness)
            end
        end
    else
        -- När aimbot stängs av - släpp sticky lock
        if stickyLocked then
            stickyLocked = false
            stickyTarget = nil
            aimTriggered = false
            print("🔓 Aimbot disabled - sticky lock released")
        end
    end
    
    updateESP()
    
    -- Speed Ghosts / Macro
    if Settings.Macro.Enabled and Settings.Macro.Active and LocalPlayer.Character then
        local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = Settings.Macro.Speed
        end
    end
    
    if Settings.Movement.Noclip and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end))

AddConnection(UserInputService.JumpRequest:Connect(function()
    if Settings.Movement.InfiniteJump and LocalPlayer.Character then
        local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end))

AddConnection(Players.PlayerAdded:Connect(createESP))
